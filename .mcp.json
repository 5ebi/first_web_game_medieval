{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.84"],
      "env": {
        "PLAYWRIGHT_MCP_DEVICE": "${PLAYWRIGHT_MCP_DEVICE:-iPhone 15}",
        "PLAYWRIGHT_MCP_HEADLESS": "${PLAYWRIGHT_MCP_HEADLESS:-true}",
        "PLAYWRIGHT_MCP_ISOLATED": "true",
        "PLAYWRIGHT_MCP_CAPS": "vision",
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "${CHROME_PATH:-}",
        "PLAYWRIGHT_MCP_OUTPUT_DIR": ".playwright-mcp"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--headless",
        "--isolated",
        "--viewport=1280x800",
        "--executablePath=${CHROME_PATH:-}",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
